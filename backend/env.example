# Azure Entra ID - BACKEND API App Registration
BE_CLIENT_ID=your_backend_api_client_id_here
BE_TENANT_ID=your_tenant_id_here
# Optional: AZURE_EXPECTED_AUDIENCE=api://your_backend_client_id

# GitHub Enterprise Cloud (github.com) OAuth
GHEC_CLIENT_ID=your_ghec_client_id_here
GHEC_CLIENT_SECRET=your_ghec_client_secret_here
GHEC_REDIRECT_URI=http://localhost:3000/auth/callback/ghec

# GitHub Enterprise Server (Optional - Self-hosted)
# Leave empty if not using Ghes
GHES_BASE_URL=
GHES_CLIENT_ID=
GHES_CLIENT_SECRET=
GHES_REDIRECT_URI=http://localhost:3000/auth/callback/ghes
