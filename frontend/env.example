# Backend API URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Azure Entra ID - FRONTEND SPA App Registration
# Create a separate app registration for your frontend
# Get these from: https://portal.azure.com → Azure AD → App registrations → Frontend SPA app
NUXT_PUBLIC_AZURE_CLIENT_ID=your_frontend_spa_client_id_here
NUXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/your_tenant_id

# Backend API Scope
# This should match what you exposed in the Backend API app registration
# Format: api://backend_client_id/scope_name
NUXT_PUBLIC_AZURE_API_SCOPE=api://your_backend_client_id/access_as_user

# Steps to create Frontend SPA app:
# 1. Azure Portal → App registrations → New registration
# 2. Name: "My App Frontend"
# 3. Redirect URI: Single-page application → http://localhost:3000
# 4. After creation → API permissions → Add permission → My APIs → Select backend app → access_as_user
# 5. Copy the Application (client) ID → Use as NUXT_PUBLIC_AZURE_CLIENT_ID above
