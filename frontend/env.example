# Backend API Base URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Azure Entra ID - FRONTEND SPA App Registration
NUXT_PUBLIC_AZURE_CLIENT_ID=your_frontend_spa_client_id_here
NUXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/your_tenant_id

# Backend API Scope (Azure)
NUXT_PUBLIC_AZURE_API_SCOPE=api://your_backend_client_id/access_as_user
